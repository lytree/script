# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# Node fnm 配置
# 应用: winget configure -f configurations\fnm.winget --accept-configuration-agreements --disable-interactivity
properties:
  configurationVersion: 0.2.0
  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: fnmPackage
      directives:
        description: 安装 Node 版本管理器 fnm
        securityContext: elevated
      settings:
        id: Schniz.fnm
        source: winget
