# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# WSL 平台配置：启用虚拟机功能 + 安装新版 WSL
# 应用: winget configure -f configurations\wsl.winget --accept-configuration-agreements --disable-interactivity
properties:
  configurationVersion: 0.2.0
  assertions:
    - resource: Microsoft.Windows.Developer/OsVersion
      id: osVersion
      directives:
        description: 验证系统版本 (Win10 21H2+ / Win11)
        allowPrerelease: true
      settings:
        MinVersion: '10.0.19044'
  resources:
    - resource: Microsoft.Windows.Developer/VirtualMachinePlatform
      id: vmPlatform
      directives:
        description: 启用虚拟机平台（WSL2 前置功能）
        allowPrerelease: true
        securityContext: elevated
      settings:
        Ensure: Present
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: wslPackage
      directives:
        description: 安装新版 WSL（Microsoft.WSL）
        securityContext: elevated
      settings:
        id: Microsoft.WSL
        source: winget
