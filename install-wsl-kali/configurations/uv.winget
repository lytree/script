# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# Python uv 配置
# 应用: winget configure -f configurations\uv.winget --accept-configuration-agreements --disable-interactivity
properties:
  configurationVersion: 0.2.0
  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: uvPackage
      directives:
        description: 安装 Python 包管理器 uv
        securityContext: elevated
      settings:
        id: astral-sh.uv
        source: winget
